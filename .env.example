# ===========================================
# Marathon Challenge Protocol - 環境変数設定
# ===========================================

# Next.js Configuration
NEXT_PUBLIC_APP_NAME=Marathon Challenge Protocol
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# 🔒 セキュリティ重要: 以下は絶対に公開しない
# ===========================================

# Database Configuration (サーバーサイドのみ)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=marathon_protocol

# Blockchain Configuration
NEXT_PUBLIC_CHAIN_ID=11155111  # Sepolia testnet (本番は1)
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# 🚨 CRITICAL: Private Keys (絶対に秘匿)
ADMIN_PRIVATE_KEY=0x...your_private_key_here
MINTING_PRIVATE_KEY=0x...separate_minting_key_here

# Contract Addresses (デプロイ後に設定)
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x...deployed_contract_address
NFT_CONTRACT_ADDRESS=0x...deployed_contract_address

# Alchemy API (サーバーサイドのみ)
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# IPFS Configuration (サーバーサイドのみ)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# JWT Secret (サーバーサイドのみ)
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters

# Admin Configuration
ADMIN_WALLET_ADDRESS=0x...admin_wallet_address

# Development
NODE_ENV=development

# ===========================================
# 📝 セキュリティチェックリスト:
# ===========================================
# ✅ .env.local は .gitignore に含まれている
# ✅ PRIVATE_KEY は絶対に GitHub にコミットしない
# ✅ 本番環境では環境変数をサーバーで直接設定
# ✅ JWT_SECRET は32文字以上のランダム文字列
# ✅ API キーは定期的にローテーション
# ===========================================